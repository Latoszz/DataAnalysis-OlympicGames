    <DTS:Executable
      DTS:refId="Package\Purge and Refill"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{3601DBE3-47C3-4E94-8442-30D4C956ABD8}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Purge and Refill"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{03769665-D7A5-422A-903D-84C5D7E7EC10}"
          SQLTask:SqlStatementSource="TRUNCATE TABLE Result;&#xA;DELETE FROM Placement;&#xA;DELETE FROM Medal;&#xA;DELETE FROM [Event];&#xA;DELETE FROM CountryYear;&#xA;DELETE FROM Athlete;&#xA;&#xA;&#xA;INSERT INTO Placement (id, number)&#xA;SELECT idT, [number] FROM PlacementSt;&#xA;&#xA;INSERT INTO Medal (id, [name])&#xA;SELECT idT, [name] FROM MedalSt;&#xA;&#xA;INSERT INTO CountryYear (id, [year], NOC, [name], inflation, gdp_per_capita, gdp_healthcare_percentage, total_population, stability, avg_tariff)&#xA;SELECT idT as id, [year], NOC, [name], inflation, gdp_per_capita, gdp_healthcare_percentage, total_population, stability, avg_tariff FROM CountryYearSt;&#xA;&#xA;INSERT INTO [Event] (id, [name], [gender], [discipline] )&#xA;SELECT idT, [name], gender, discipline FROM EventSt;&#xA;&#xA;INSERT INTO Athlete(id, height, [weight], [yearborn])&#xA;SELECT DISTINCT [idnew] as id, height, [weight], yearborn FROM AthleteSt;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
